{
  "manifest_version": 3,
  "name": "Radeski GSC Indexer",
  "version": "1.3.1",
  "description": "GSC: search → Запросить 1× → kutish → Закрыть → 60s keyingi",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": [
    "https://search.google.com/*"
  ],
  "action": {
    "default_title": "Radeski GSC Indexer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://search.google.com/search-console*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
