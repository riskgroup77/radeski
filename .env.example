# Backend API URL (Vite frontend)
# Production radeski.uz: bo'sh qoldiring — nginx /api orqali proxy qiladi (CORS yo'q)
VITE_API_URL=
# Local dev: to'g'ridan-to'g'ri API
# VITE_API_URL=https://radeskiapi.arxivfjsti.uz

# DeepSeek AI (server-side only — never use VITE_ prefix)
# Local: .env yoki server/secrets.local.ts (nusxa: secrets.local.example.ts)
# Vercel: Settings → Environment Variables → DEEPSEEK_API_KEY
DEEPSEEK_API_KEY="MY_DEEPSEEK_API_KEY"
DEEPSEEK_MODEL="deepseek-chat"
# DEEPSEEK_API_BASE="https://api.deepseek.com"

# Production Express server port (npm run server after npm run build)
CHAT_SERVER_PORT=8787
PORT=8787

# Optional: public site URL for metadata
APP_URL="http://localhost:3000"
